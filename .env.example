NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
LOG_LEVEL=info

# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Email delivery (Resend). Use a verified sender domain in production.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Events <no-reply@example.com>

# Public frontend origin used to construct verification and password-reset links.
FRONTEND_URL=http://localhost:5173

# One-time identity link lifetimes, in minutes.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Maximum verification/reset email requests per normalized email + IP per hour.
IDENTITY_EMAIL_RATE_LIMIT_PER_HOUR=3
