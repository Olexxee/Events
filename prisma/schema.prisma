model VybeTimeSlotOccurrence {
  id                String                          @id @default(uuid()) @db.Uuid
  offeringId        String                          @map("offering_id") @db.Uuid
  offeringVersion   Int                             @map("offering_version")
  inventoryMode     VybeTimeSlotInventoryMode       @map("inventory_mode")
  timezone          String                          @db.VarChar(80)
  serviceStartsAt   DateTime                        @map("service_starts_at") @db.Timestamptz(6)
  serviceEndsAt     DateTime                        @map("service_ends_at") @db.Timestamptz(6)
  preBufferSeconds  Int                             @default(0) @map("pre_buffer_seconds")
  postBufferSeconds Int                             @default(0) @map("post_buffer_seconds")
  blockedStartsAt   DateTime                        @map("blocked_starts_at") @db.Timestamptz(6)
  blockedEndsAt     DateTime                        @map("blocked_ends_at") @db.Timestamptz(6)
  status            VybeTimeSlotOccurrenceStatus    @default(ACTIVE)
  resourceGroupId   String?                         @map("resource_group_id") @db.Uuid
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  offering          VybeOffering                    @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  resourceGroup     VybeTimeSlotResourceGroup?      @relation(fields: [resourceGroupId], references: [id], onDelete: Restrict)
  capacity          VybeTimeSlotCapacity?
  holds             VybeTimeSlotHold[]
  occupancies       VybeTimeSlotResourceOccupancy[]

  @@index([offeringId, status, serviceStartsAt], map: "vybe_time_slot_occurrences_offering_status_start_idx")
  @@index([resourceGroupId, status, serviceStartsAt], map: "vybe_time_slot_occurrences_group_status_start_idx")
  @@map("vybe_time_slot_occurrences")
}

model VybeTimeSlotCapacity {
