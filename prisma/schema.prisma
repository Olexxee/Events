generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shared infrastructure only. Domain models are introduced with their owning modules.
model OutboxMessage {
  id                String    @id @default(uuid()) @db.Uuid
  aggregateType     String    @map("aggregate_type")
  aggregateId       String    @map("aggregate_id")
  eventType         String    @map("event_type")
  deduplicationKey  String    @unique @map("deduplication_key")
  payload            Json
  occurredAt         DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt        DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts           Int       @default(0)
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError          String?   @map("last_error")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_messages")
}

// Platform-wide, append-only audit record. Actor references intentionally have no domain FK.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  actorType    String   @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String   @default("success")
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
