generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("organization_membership_role")
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("organization_membership_status")
}

enum OrganizerApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  WITHDRAWN
  SUSPENDED
  REVOKED

  @@map("organizer_application_status")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALES_PAUSED
  ONGOING
  COMPLETED
  POSTPONED
  CANCELLED

  @@map("event_status")
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID

  @@map("event_format")
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  INVITATION_ONLY

  @@map("event_visibility")
}

enum EventAccessPolicy {
  OPEN
  APPROVAL_REQUIRED
  INVITATION_ONLY

  @@map("event_access_policy")
}

enum EventExperienceLevel {
  STANDARD
  PREMIUM

  @@map("event_experience_level")
}

enum EventModerationStatus {
  CLEAR
  UNDER_REVIEW
  RESTRICTED
  SUSPENDED
  TAKEDOWN

  @@map("event_moderation_status")
}

enum PlatformRole {
  SUPPORT
  PLATFORM_ADMIN
  FINANCE_ADMIN
  SUPER_ADMIN

  @@map("platform_role")
}

enum EventInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED

  @@map("event_invitation_status")
}

enum EventAccessRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("event_access_request_status")
}

enum EventAccessGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("event_access_grant_status")
}

enum EventAccessGrantSource {
  INVITATION
  ACCESS_REQUEST
  PLATFORM

  @@map("event_access_grant_source")
}

enum TicketTypeStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("ticket_type_status")
}

enum TicketHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED

  @@map("ticket_hold_status")
}

enum VybeCategory {
  ACCOMMODATION
  DINING
  DRINKS
  TABLES_LOUNGES
  VIP_EXPERIENCES
  OTHER_SERVICES

  @@map("vybe_category")
}

enum VybeProviderApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("vybe_provider_application_status")
}

enum VybeProviderApprovalStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED

  @@map("vybe_provider_approval_status")
}

enum VybeProviderReviewAction {
  REVIEW_STARTED
  INFORMATION_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED

  @@map("vybe_provider_review_action")
}

enum VybeEvidenceStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED

  @@map("vybe_evidence_status")
}

enum VybeOfferingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED

  @@map("vybe_offering_status")
}

enum VybeOfferingVersionStatus {
  DRAFT
  PUBLISHED

  @@map("vybe_offering_version_status")
}

enum VybeInventoryPoolStatus {
  ACTIVE
  PAUSED

  @@map("vybe_inventory_pool_status")
}

enum VybeInventoryHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED

  @@map("vybe_inventory_hold_status")
}

enum VybeTimeSlotInventoryMode {
  CAPACITY
  EXCLUSIVE

  @@map("vybe_time_slot_inventory_mode")
}

enum VybeTimeSlotOccurrenceStatus {
  ACTIVE
  PAUSED

  @@map("vybe_time_slot_occurrence_status")
}

enum VybeTimeSlotHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED

  @@map("vybe_time_slot_hold_status")
}

enum VybeTimeSlotResourceOccupancyStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED

  @@map("vybe_time_slot_resource_occupancy_status")
}

enum VybeBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("vybe_booking_status")
}

enum VybeBookingSourceType {
  QUANTITY_POOL
  CAPACITY_SESSION
  EXCLUSIVE_RESOURCE

  @@map("vybe_booking_source_type")
}

enum VybeAccommodationPropertyStatus {
  ACTIVE
  PAUSED

  @@map("vybe_accommodation_property_status")
}

enum VybeAccommodationRoomCategoryStatus {
  ACTIVE
  PAUSED

  @@map("vybe_accommodation_room_category_status")
}

enum VybeAccommodationAllocationStatus {
  ACTIVE
  PAUSED
  RELEASED

  @@map("vybe_accommodation_allocation_status")
}

enum VybeAccommodationHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED

  @@map("vybe_accommodation_hold_status")
}

// Shared infrastructure.
model OutboxMessage {
  id               String    @id @default(uuid()) @db.Uuid
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id")
  eventType        String    @map("event_type")
  deduplicationKey String    @unique @map("deduplication_key")
  payload          Json
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt      DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts         Int       @default(0)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_messages")
}

// Platform-wide, append-only audit record. Actor references intentionally have no domain FK.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  actorType    String   @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String   @default("success")
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model User {
  id                                  String                                  @id @default(uuid()) @db.Uuid
  email                               String                                  @unique @db.VarChar(320)
  emailVerifiedAt                     DateTime?                               @map("email_verified_at") @db.Timestamptz(6)
  status                              UserStatus                              @default(ACTIVE)
  createdAt                           DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordCredential                  PasswordCredential?
  profile                             UserProfile?
  sessions                            Session[]
  memberships                         OrganizationMembership[]
  platformRoles                       PlatformRoleAssignment[]
  createdOrganizations                Organization[]                          @relation("OrganizationCreator")
  organizerApplicationsSubmitted      OrganizerApplication[]                  @relation("OrganizerApplicationApplicant")
  organizerApplicationsReviewed       OrganizerApplication[]                  @relation("OrganizerApplicationReviewer")
  eventInvitationsReceived            EventInvitation[]                       @relation("EventInvitationRecipient")
  eventInvitationsIssued              EventInvitation[]                       @relation("EventInvitationIssuer")
  eventAccessRequests                 EventAccessRequest[]
  eventAccessGrants                   EventAccessGrant[]
  eventAccessHoldsCreated             EventAccessHold[]                       @relation("EventAccessHoldActor")
  eventAccessHoldsReleased            EventAccessHold[]                       @relation("EventAccessHoldReleaser")
  ticketTypesCreated                  TicketType[]                            @relation("TicketTypeCreator")
  ticketHolds                         TicketHold[]
  vybeInventoryHolds                  VybeInventoryHold[]
  vybeTimeSlotHolds                   VybeTimeSlotHold[]
  vybeBookingsAsCustomer              VybeBooking[]                           @relation("VybeBookingCustomer")
  vybeBookingStatusChanges            VybeBookingStatusHistory[]              @relation("VybeBookingStatusActor")
  vybeInventoryAllocations            VybeInventoryAllocation[]
  vybeAccommodationAllocationsCreated VybeAccommodationAllocation[]           @relation("VybeAccommodationAllocationCreator")
  vybeAccommodationAdjustments        VybeAccommodationAllocationAdjustment[]
  vybeAccommodationHolds              VybeAccommodationHold[]
  vybeApplicationsSubmitted           VybeProviderApplication[]               @relation("VybeApplicationApplicant")
  vybeProviderReviews                 VybeProviderReview[]
  vybeEvidenceReviewed                VybeProviderEvidence[]                  @relation("VybeEvidenceReviewer")
  vybeApprovalsGranted                VybeProviderApproval[]                  @relation("VybeApprovalGrantor")
  vybeApprovalsSuspended              VybeProviderApproval[]                  @relation("VybeApprovalSuspender")
  vybeApprovalsRevoked                VybeProviderApproval[]                  @relation("VybeApprovalRevoker")
  vybeOfferingsCreated                VybeOffering[]                          @relation("VybeOfferingCreator")
  vybeOfferingVersionsCreated         VybeOfferingVersion[]                   @relation("VybeOfferingVersionCreator")
  vybeCategoryActivations             VybeCategoryActivation[]                @relation("VybeCategoryActivationActor")
  eventAccessRequestsDecided          EventAccessRequest[]                    @relation("EventAccessRequestDecider")
  eventAccessGrantsRevoked            EventAccessGrant[]                      @relation("EventAccessGrantRevoker")

  @@index([status, createdAt])
  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(120)
  phone       String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_credentials")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(120)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, refreshExpiresAt])
  @@index([familyId, revokedAt])
  @@map("sessions")
}

model Organization {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @db.VarChar(160)
  slug                     String                    @unique @db.VarChar(180)
  status                   OrganizationStatus        @default(ACTIVE)
  createdById              String                    @map("created_by_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                User                      @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships              OrganizationMembership[]
  organizerApplications    OrganizerApplication[]
  events                   Event[]
  eventInvitations         EventInvitation[]
  eventAccessRequests      EventAccessRequest[]
  eventAccessGrants        EventAccessGrant[]
  vybeProviderProfile      VybeProviderProfile?
  vybeProviderApplications VybeProviderApplication[]
  vybeBookings             VybeBooking[]

  @@index([status, createdAt])
  @@map("organizations")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  role           OrganizationMembershipRole   @default(MEMBER)
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("organization_memberships")
}

model PlatformRoleAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  grantedAt DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?      @map("granted_by") @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@index([role, grantedAt])
  @@map("platform_role_assignments")
}

model OrganizerApplication {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @map("organization_id") @db.Uuid
  applicantUserId    String                     @map("applicant_user_id") @db.Uuid
  status             OrganizerApplicationStatus @default(SUBMITTED)
  applicationMessage String                     @map("application_message") @db.VarChar(2000)
  websiteUrl         String?                    @map("website_url") @db.VarChar(500)
  submittedAt        DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId   String?                    @map("reviewed_by_user_id") @db.Uuid
  decisionReason     String?                    @map("decision_reason") @db.VarChar(1000)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  applicant          User                       @relation("OrganizerApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewer           User?                      @relation("OrganizerApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([applicantUserId, submittedAt])
  @@index([status, submittedAt])
  @@index([organizationId, status])
  @@map("organizer_applications")
}

model EventCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events      Event[]

  @@index([isActive, sortOrder])
  @@map("event_categories")
}

model Event {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  categoryId       String                @map("category_id") @db.Uuid
  title            String                @db.VarChar(180)
  slug             String                @db.VarChar(200)
  summary          String                @db.VarChar(500)
  description      String                @db.Text
  format           EventFormat
  visibility       EventVisibility       @default(PUBLIC)
  accessPolicy     EventAccessPolicy     @default(OPEN) @map("access_policy")
  experienceLevel  EventExperienceLevel? @map("experience_level")
  status           EventStatus           @default(DRAFT)
  moderationStatus EventModerationStatus @default(CLEAR) @map("moderation_status")
  timezone         String                @db.VarChar(80)
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         EventCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  schedules        EventSchedule[]
  venue            EventVenue?
  revisions        EventRevision[]
  invitations      EventInvitation[]
  accessRequests   EventAccessRequest[]
  accessGrants     EventAccessGrant[]
  accessHolds      EventAccessHold[]
  ticketTypes      TicketType[]
  ticketHolds      TicketHold[]

  @@unique([organizationId, slug])
  @@index([status, visibility, moderationStatus, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([organizationId, status, updatedAt])
  @@map("events")
}

model EventSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(6)
  label     String?  @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, startsAt])
  @@map("event_schedules")
}

model EventVenue {
  id                 String   @id @default(uuid()) @db.Uuid
  eventId            String   @unique @map("event_id") @db.Uuid
  displayName        String?  @map("display_name") @db.VarChar(160)
  city               String?  @db.VarChar(100)
  state              String?  @db.VarChar(100)
  country            String?  @db.VarChar(100)
  exactAddress       String?  @map("exact_address") @db.VarChar(500)
  accessInstructions String?  @map("access_instructions") @db.Text
  privateUrl         String?  @map("private_url") @db.VarChar(1000)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("event_venues")
}

model EventRevision {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  actorUserId    String   @map("actor_user_id") @db.Uuid
  changeType     String   @map("change_type") @db.VarChar(40)
  snapshot       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, revisionNumber])
  @@index([eventId, createdAt])
  @@map("event_revisions")
}

model EventInvitation {
  id              String                @id @default(uuid()) @db.Uuid
  eventId         String                @map("event_id") @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  recipientUserId String                @map("recipient_user_id") @db.Uuid
  issuedByUserId  String                @map("issued_by_user_id") @db.Uuid
  tokenDigest     String                @unique @map("token_digest") @db.Char(64)
  status          EventInvitationStatus @default(PENDING)
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz(6)
  declinedAt      DateTime?             @map("declined_at") @db.Timestamptz(6)
  revokedAt       DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  event           Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient       User                  @relation("EventInvitationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  issuer          User                  @relation("EventInvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, recipientUserId, status])
  @@index([status, expiresAt])
  @@map("event_invitations")
}

model EventAccessRequest {
  id              String                   @id @default(uuid()) @db.Uuid
  eventId         String                   @map("event_id") @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  requesterUserId String                   @map("requester_user_id") @db.Uuid
  status          EventAccessRequestStatus @default(SUBMITTED)
  message         String?                  @db.VarChar(500)
  decisionReason  String?                  @map("decision_reason") @db.VarChar(1000)
  decidedByUserId String?                  @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz(6)
  withdrawnAt     DateTime?                @map("withdrawn_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  event           Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester       User                     @relation(fields: [requesterUserId], references: [id], onDelete: Restrict)
  decider         User?                    @relation("EventAccessRequestDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, status, createdAt])
  @@index([requesterUserId, createdAt])
  @@map("event_access_requests")
}

model EventAccessGrant {
  id              String                 @id @default(uuid()) @db.Uuid
  eventId         String                 @map("event_id") @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  source          EventAccessGrantSource
  sourceId        String                 @map("source_id") @db.Uuid
  status          EventAccessGrantStatus @default(ACTIVE)
  canViewDetails  Boolean                @default(true) @map("can_view_details")
  canCheckout     Boolean                @default(true) @map("can_checkout")
  expiresAt       DateTime               @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?                @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?                @map("revoke_reason") @db.VarChar(1000)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
