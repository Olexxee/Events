  @@index([roomCategoryId, status, expiresAt], map: "vybe_accommodation_holds_category_status_expiry_idx")
  @@index([userId, status, expiresAt], map: "vybe_accommodation_holds_user_status_expiry_idx")
  @@map("vybe_accommodation_holds")
}

