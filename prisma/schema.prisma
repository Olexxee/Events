model VybeTimeSlotHold {
  id               String                         @id @default(uuid()) @db.Uuid
  occurrenceId     String                         @map("occurrence_id") @db.Uuid
  userId           String                         @map("user_id") @db.Uuid
  idempotencyKey   String                         @map("idempotency_key") @db.VarChar(128)
  capacityQuantity Int?                           @map("capacity_quantity")
  resourceId       String?                        @map("resource_id") @db.Uuid
  status           VybeTimeSlotHoldStatus         @default(ACTIVE)
  expiresAt        DateTime                       @map("expires_at") @db.Timestamptz(6)
  serviceStartsAt  DateTime                       @map("service_starts_at") @db.Timestamptz(6)
  serviceEndsAt    DateTime                       @map("service_ends_at") @db.Timestamptz(6)
  blockedStartsAt  DateTime                       @map("blocked_starts_at") @db.Timestamptz(6)
  blockedEndsAt    DateTime                       @map("blocked_ends_at") @db.Timestamptz(6)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
